# ═══════════════════════════════════════════════════════════════════════════
# FRONTEND variables (VITE_ prefix — these get bundled into browser JS).
# Safe to expose: anon keys and publishable keys are meant to be public.
# Set these in a .env file locally, and in your host's "Environment
# Variables" settings for the FRONTEND/build (e.g. Vercel Project Settings).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (public anon key — safe for browser, protected by RLS) ───────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google Maps JavaScript API (public browser key) ───────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# ─── EmailJS (public key — designed to be exposed client-side) ────────────
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
VITE_EMAILJS_ORDER_TEMPLATE_ID=your_order_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ─── Development-only local admin fallback ────────────────────────────────
# Never set this for production builds. Production admin access requires
# Supabase Auth plus a row in the staff_users allowlist.
# VITE_LOCAL_ADMIN_PW=use-a-development-only-password


# ═══════════════════════════════════════════════════════════════════════════
# BACKEND / SERVERLESS-ONLY variables — NEVER prefix with VITE_, NEVER put
# these in the frontend .env, NEVER commit them anywhere. Set these ONLY in
# your hosting provider's serverless function environment (e.g. Vercel
# Project Settings → Environment Variables, scoped to Production/Preview —
# NOT exposed to the client bundle since there's no VITE_ prefix).
#
# These power /api/create-checkout-session.js, /api/stripe-webhook.js, and
# /api/order-status.js — the files that actually talk to Stripe and write
# orders to the database.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Stripe (SECRET — starts with sk_, never sk_ in frontend code) ─────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── Supabase server keys ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Dashboard → Project Settings → API → service_role (NOT anon)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site URL and order lookup signing key ─────────────────────────────────
PUBLIC_SITE_URL=https://your-deployed-domain.com
ORDER_LOOKUP_TOKEN_SECRET=generate-a-long-random-secret

# ─── Shared API rate limiting (Upstash Redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
